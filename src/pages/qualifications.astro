---
import Layout from '../layouts/Layout.astro';

// Verified qualifications — confirmed from Amy's own social posts.
const verified = [
  {
    title: 'Registered childminder',
    body: 'Registered on the Early Years Register and both parts of the Childcare Register through the Suffolk Childcare Agency, an Ofsted-registered childminder agency. Registration number SCA170534, registered 7 July 2026.',
    cls: 'pill pill-sky',
  },
  {
    title: 'Qualified Teacher Status (QTS)',
    body: 'Trained and experienced primary school teacher, with classroom experience across early years and KS1.',
    cls: 'pill',
  },
  {
    title: 'Extensive Early Years experience',
    body: 'Several years of focused Early Years practice — the foundation for everything we do at Blackfen Little Learners.',
    cls: 'pill pill-rose',
  },
  {
    title: 'Paediatric First Aid',
    body: 'Full 12-hour paediatric first aid certification completed, in line with EYFS requirements.',
    cls: 'pill pill-sky',
  },
  {
    title: 'Safeguarding training',
    body: 'Up-to-date safeguarding training completed, covering child protection responsibilities required for Ofsted registration.',
    cls: 'pill pill-sage',
  },
  {
    title: 'Enhanced DBS',
    body: 'Enhanced DBS check completed via the update service, alongside checks for adults living in the home.',
    cls: 'pill pill-sun',
  },
  {
    title: 'Public liability insurance',
    body: 'Childminding insurance in place through a recognised provider, ahead of opening.',
    cls: 'pill pill-peach',
  },
  {
    title: 'Food hygiene',
    body: 'Food hygiene training completed, so meals and snacks at the setting are prepared safely.',
    cls: 'pill pill-rose',
  },
];

---

<Layout
  title="Qualifications · Blackfen Little Learners"
  description="Amy King's qualifications and checks: registered childminder (SCA170534), Qualified Teacher Status, Early Years experience, paediatric first aid, safeguarding, enhanced DBS, public liability insurance, and food hygiene."
>
  <section class="py-16 md:py-20">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Qualifications & checks</p>
        <h1 class="text-balance">Trained, checked, and fully registered.</h1>
        <p class="mt-6 text-ink-700/85">
          Choosing childcare is built on trust, so here's a full summary of
          the qualifications, checks, and registration behind Blackfen
          Little Learners.
        </p>
      </div>

      <h2 class="mt-14 text-2xl">In place</h2>
      <ul class="mt-6 grid md:grid-cols-2 gap-6">
        {verified.map((c) => (
          <li class="card">
            <span class:list={[c.cls, 'mb-4']}>{c.title}</span>
            <p class="text-ink-700/85">{c.body}</p>
          </li>
        ))}
      </ul>

      <div class="mt-16 card-tinted">
        <p class="eyebrow mb-3">Registered childminder</p>
        <p>
          Blackfen Little Learners is registered through the Suffolk
          Childcare Agency, a childminder agency registered and inspected by
          Ofsted — registration number <strong>SCA170534</strong>, on the
          Early Years Register and both the compulsory and voluntary parts
          of the Childcare Register. We're always happy to show the
          certificate and other paperwork in person at an introductory
          visit.
        </p>
      </div>
    </div>
  </section>
</Layout>
